<?php

use Drupal\file\Entity\File;
use Drupal\ai_provider_yolov8\OperationType\ImageObjectDetection\ImageObjectDetectionInput;

/**
 * @file
 * Primary module hooks for AI Focal Point module.
 */

 
function ai_focal_point_page_top(array &$page_top) : void {
  // Load an existing file.
  $file = File::load(1);
  // Convert the file into an operation type input.
  $input = new ImageObjectDetectionInput($file);

  // Get objects from YOLOv8.
  $objects_detected =  \Drupal::service('ai.provider')
  ->createInstance('ai_yolov8', [])
  ->imageObjectDetection($input, 'yolov8')
  ->getNormalized();
  
  // Create the object array for calculation.
  $objects = [];
  foreach ($objects_detected as $item) {
    $objects[] = $item->getDetection();
  }
  
  // Get image width/height.
  $file_path = \Drupal::service('file_system')
    ->realpath($file->getFileUri());
  [$width, $height] = getimagesize($file_path);

  // Send data to custom calculation service.
  $calculation =  \Drupal::service('ai_focal_point.calculator')
  ->computeFocalPoint($objects, $width, $height);

  // print calculation response on page.
  print_r($calculation);
}
